<Window
    x:Class="ZekPcSayac.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ZekPcSayac"
    Width="150"
    Height="76"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ShowActivated="False">
    <Grid x:Name="RootGrid">
        <StackPanel x:Name="TimerPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="2"
                    Visibility="Visible">
            <TextBlock x:Name="RemainingText"
                       Text="02:00:00"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="23"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Effect="{x:Null}" />
            <Button x:Name="PauseResumeButton"
                    Content="Durdur"
                    Width="68"
                    Height="23"
                    Margin="0,3,0,0"
                    Padding="5,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Background="#CC202020"
                    Foreground="White"
                    BorderThickness="0"
                    Click="PauseResumeButton_Click" />
        </StackPanel>

        <Grid x:Name="PausedPanel"
              Background="Black"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="220">
                <TextBlock x:Name="PausedRemainingText"
                           Text="02:00:00"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="30"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="Kullanım duraklatıldı"
                           Foreground="#BFFFFFFF"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="0,0,0,22" />
                <Button Content="Devam Et"
                        Height="38"
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="PauseResumeButton_Click" />
                <Button Content="Bilgisayarı Kapat"
                        Height="34"
                        FontSize="12"
                        Click="ShutdownButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
